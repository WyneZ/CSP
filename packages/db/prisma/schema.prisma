// Milestone-1 scope — see docs/adr/0002-milestone-1-schema-scope.md.
// Milestone-2/3 addition (2026-09-10, under time pressure — see NEXT.md):
// Vendor, Requisition, RequisitionLine, and the StockMovement link to a
// requisition line. GoodsReceipt/Unit/MaterialUnitConversion still deferred
// past v1 — "Store In" stays a plain RECEIPT ledger row with no PO/GRN
// document behind it yet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SITE_ENGINEER
  STOREKEEPER
  VIEWER
}

enum SiteStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum MovementType {
  RECEIPT
  ISSUE
}

enum RequisitionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_ISSUED
  ISSUED
  REJECTED
  CANCELLED
}

// -----------------------------------------------------------------------
// Tenant — bootstrap record. No tenantId or createdBy/updatedBy on itself:
// it exists before any user does. One row in v1, but every table below is
// scoped by tenantId from day one (schema foundations, non-negotiable).
// -----------------------------------------------------------------------
model Tenant {
  id              String   @id @default(uuid())
  name            String
  defaultCurrency String   @default("MMK")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users        User[]
  sites        Site[]
  materials    Material[]
  movements    StockMovement[]
  vendors      Vendor[]
  requisitions Requisition[]

  @@map("tenant")
}

model User {
  id           String  @id @default(uuid())
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id])
  name         String
  email        String
  passwordHash String
  role         Role
  isActive     Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("UserCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?    @relation("UserUpdatedBy", fields: [updatedById], references: [id])

  // back-relations: this user as the creator/updater of other users
  createdUsers User[] @relation("UserCreatedBy")
  updatedUsers User[] @relation("UserUpdatedBy")

  // back-relations: this user as the creator/updater of rows on other tables
  sitesCreated          Site[]            @relation("SiteCreatedBy")
  sitesUpdated          Site[]            @relation("SiteUpdatedBy")
  materialsCreated      Material[]        @relation("MaterialCreatedBy")
  materialsUpdated      Material[]        @relation("MaterialUpdatedBy")
  movementsCreated      StockMovement[]   @relation("MovementCreatedBy")
  vendorsCreated        Vendor[]          @relation("VendorCreatedBy")
  vendorsUpdated        Vendor[]          @relation("VendorUpdatedBy")
  requisitionsRequested Requisition[]     @relation("RequisitionRequestedBy")
  requisitionsApproved  Requisition[]     @relation("RequisitionApprovedBy")
  requisitionsCreated   Requisition[]     @relation("RequisitionCreatedBy")
  requisitionsUpdated   Requisition[]     @relation("RequisitionUpdatedBy")
  requisitionLinesCreated RequisitionLine[] @relation("RequisitionLineCreatedBy")
  requisitionLinesUpdated RequisitionLine[] @relation("RequisitionLineUpdatedBy")

  @@unique([tenantId, email])
  @@map("user")
}

model Site {
  id        String     @id @default(uuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  name      String
  client    String?
  location  String?
  startDate DateTime?
  endDate   DateTime?
  status    SiteStatus @default(ACTIVE)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("SiteCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?    @relation("SiteUpdatedBy", fields: [updatedById], references: [id])

  movements    StockMovement[]
  requisitions Requisition[]

  @@unique([tenantId, name])
  @@map("site")
}

model Material {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  code     String
  name     String
  category String?

  // milestone-1 simplification (ADR-0002) — becomes baseUnitId (FK to a
  // real Unit table) in a later migration, once conversion matters.
  unit String

  reorderLevel Decimal? @db.Decimal(14, 3)
  standardRate Decimal? @db.Decimal(14, 2)
  currency     String   @default("MMK")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("MaterialCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?    @relation("MaterialUpdatedBy", fields: [updatedById], references: [id])

  movements        StockMovement[]
  requisitionLines RequisitionLine[]

  @@unique([tenantId, code])
  @@map("material")
}

// -----------------------------------------------------------------------
// StockMovement — append-only ledger. No updatedAt / updatedById, no soft
// delete: a mistake is corrected by posting a new row (reversalOfId), never
// by editing this one. requisitionLineId is set only on ISSUE rows created
// by fulfilling a requisition — RECEIPT (Store In) rows leave it null.
// -----------------------------------------------------------------------
model StockMovement {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  siteId       String
  site         Site         @relation(fields: [siteId], references: [id])
  materialId   String
  material     Material     @relation(fields: [materialId], references: [id])
  movementType MovementType
  quantity     Decimal      @db.Decimal(14, 3)

  requisitionLineId String?
  requisitionLine   RequisitionLine? @relation(fields: [requisitionLineId], references: [id])

  reversalOfId String?
  reversalOf   StockMovement?  @relation("MovementReversal", fields: [reversalOfId], references: [id])
  reversedBy   StockMovement[] @relation("MovementReversal")

  remarks String?

  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("MovementCreatedBy", fields: [createdById], references: [id])

  // current stock = SUM(quantity) WHERE tenantId/siteId/materialId match —
  // this index is what makes that read fast.
  @@index([tenantId, siteId, materialId])
  @@map("stock_movement")
}

// -----------------------------------------------------------------------
// Vendor — v1 boundary is deliberately thin: name + contact only. No
// ledger, no PO history, no balance. That's the whole point of "not v2".
// -----------------------------------------------------------------------
model Vendor {
  id           String  @id @default(uuid())
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id])
  name         String
  contactName  String?
  contactPhone String?
  contactEmail String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("VendorCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?    @relation("VendorUpdatedBy", fields: [updatedById], references: [id])

  @@unique([tenantId, name])
  @@map("vendor")
}

// -----------------------------------------------------------------------
// Requisition — the header + state machine. Status transitions are
// enforced in RequisitionsService, not here; Prisma has no CHECK
// constraints (ADR-0001), so an invalid transition is a service-layer bug,
// not a database one, until that's revisited.
// -----------------------------------------------------------------------
model Requisition {
  id       String            @id @default(uuid())
  tenantId String
  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  siteId   String
  site     Site              @relation(fields: [siteId], references: [id])
  status   RequisitionStatus @default(DRAFT)

  requestedById String
  requestedBy   User    @relation("RequisitionRequestedBy", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?   @relation("RequisitionApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  rejectedReason String?

  remarks String?

  lines RequisitionLine[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("RequisitionCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?    @relation("RequisitionUpdatedBy", fields: [updatedById], references: [id])

  @@index([tenantId, siteId, status])
  @@map("requisition")
}

// -----------------------------------------------------------------------
// RequisitionLine — requestedQty/approvedQty are plain columns (they're
// decisions someone made, not history). "How much has been issued so far"
// is deliberately NOT a column here — it's SUM(StockMovement.quantity)
// for this line's ISSUE rows, same derived-not-stored rule as current
// stock. A stored running total could drift from the ledger; a derived
// one can't.
// -----------------------------------------------------------------------
model RequisitionLine {
  id            String      @id @default(uuid())
  requisitionId String
  requisition   Requisition @relation(fields: [requisitionId], references: [id])
  materialId    String
  material      Material    @relation(fields: [materialId], references: [id])
  requestedQty  Decimal     @db.Decimal(14, 3)
  approvedQty   Decimal?    @db.Decimal(14, 3)

  movements StockMovement[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("RequisitionLineCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?    @relation("RequisitionLineUpdatedBy", fields: [updatedById], references: [id])

  @@map("requisition_line")
}
